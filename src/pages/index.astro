---
export const prerender = true;

import '../styles/global.css';
import { Picture } from 'astro:assets';
import eventPhoto from '../assets/images/photo-evenement-frequences-croisees-oise.jpg';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Analytics from '../components/Analytics.astro';
import HeroMap from '../components/HeroMap.astro';
import guitar from '../assets/icons/guitar.svg?raw';
import repeat from '../assets/icons/repeat-2.svg?raw';
import messages from '../assets/icons/messages-square.svg?raw';
import sparkles from '../assets/icons/sparkles.svg?raw';
import warning from '../assets/icons/triangle-alert.svg?raw';
import mail from '../assets/icons/mail.svg?raw';
import phone from '../assets/icons/phone.svg?raw';

const siteUrl = 'https://frequences-croisees.fr';
const title = 'Fréquences Croisées — Musiciens amateurs à Précy-sur-Oise';
const description = 'Fréquences Croisées rassemble les musiciens amateurs de Précy-sur-Oise et des communes voisines pour jouer, partager et créer ensemble.';

const activities = [
  ['Jam sessions', 'Improviser et jouer librement, sans pression et dans tous les styles.', guitar],
  ['Répétitions', 'Travailler des morceaux et construire des répertoires communs.', repeat],
  ['Échanges', 'Partager ses connaissances, découvrir d’autres univers et progresser ensemble.', messages],
  ['Création', 'Faire naître des collaborations et de nouveaux projets musicaux.', sparkles]
];
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#102c2a" />
    <link rel="canonical" href={`${siteUrl}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${siteUrl}/`} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Fréquences Croisées',
      url: siteUrl,
      description
    })} />
    <Analytics />
  </head>
  <body>
    <SiteHeader home />

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">Précy-sur-Oise et alentours.</p>
          <h1 id="hero-title"><span class="hero-title-intro">Un lieu de rencontre<br />pour les</span> <span class="hero-title-accent">musiciens.</span></h1>
          <p class="hero-lead">Jouer ensemble, se rencontrer, partager ses influences et faire vivre la musique localement.</p>
          <a class="button" href="#participer">Rejoignez-nous <span aria-hidden="true">↘</span></a>
        </div>
        <HeroMap />
      </section>

      <section class="intro" id="association" aria-labelledby="intro-title">
        <div>
          <p class="eyebrow">L’association</p>
          <h2 id="intro-title">Tous les niveaux.<br />Tous les univers.</h2>
        </div>
        <div class="intro-text">
          <p>Fréquences Croisées rassemble les musiciens amateurs de Précy-sur-Oise et des communes voisines, quels que soient leur âge, leur niveau ou leur univers musical.</p>
          <p>Notre envie est simple : favoriser la pratique musicale collective, les rencontres et le partage, dans un esprit convivial et ouvert à toutes et tous.</p>
        </div>
      </section>

      <section class="meetings" id="rencontres" aria-labelledby="meetings-title">
        <div class="meetings-heading">
          <p class="eyebrow">Des rencontres pour jouer vraiment.</p>
          <h2 id="meetings-title">Les sessions <em>croisées</em> hebdomadaires</h2>
        </div>
        <div class="session-details" aria-label="Lieu et horaires des sessions croisées">
          <div>
            <h3 class="session-label">Où ?</h3>
            <p class="session-place"><strong>Château des Érables</strong><span>Précy-sur-Oise</span></p>
          </div>
          <div>
            <h3 class="session-label">Quand ?</h3>
            <ul class="session-times">
              <li><strong>Mardi soir</strong><span><time datetime="19:00">19h</time>–<time datetime="21:00">21h</time></span></li>
              <li><strong>Samedi après-midi</strong><span><time datetime="15:00">15h</time>–<time datetime="17:00">17h</time></span></li>
            </ul>
          </div>
        </div>
        <aside class="session-notice" aria-labelledby="attendance-title">
          <p class="session-notice-heading"><span class="notice-icon" aria-hidden="true" set:html={warning} /><strong id="attendance-title">Avant de venir, faites valider votre participation.</strong></p>
          <p><a href="#participer">Contactez-nous</a> et attendez notre confirmation avant chaque session. Cela nous permet de limiter le nombre de participants et de jouer dans de bonnes conditions.</p>
        </aside>
        <div class="activity-grid">
          {activities.map(([name, text, icon]) => (
            <article class="activity-card">
              <span class="activity-icon" aria-hidden="true" set:html={icon} />
              <h3>{name}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
        <p class="equipment-note">Chacun vient avec ses instruments et équipements. Du matériel collectif viendra compléter progressivement les rencontres.</p>
      </section>

      <section class="local" id="village" aria-labelledby="local-title">
        <figure class="local-photo">
          <Picture
            src={eventPhoto}
            formats={['webp']}
            fallbackFormat="jpg"
            widths={[400, 640, 960, 1280, 1600]}
            sizes="(max-width: 800px) 90vw, 40vw"
            quality={85}
            alt="Musiciens sur scène lors d’un concert en plein air"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="local-copy">
          <p class="eyebrow">Précy-sur-Oise en musique</p>
          <h2 id="local-title">Faire vivre la musique<br />localement.</h2>
          <p>Au-delà des rencontres régulières, Fréquences Croisées souhaite participer à la vie culturelle locale et créer du lien entre les habitants.</p>
          <ul>
            <li>Participer aux manifestations communales (fête de la musique, fête communale, brocante, etc.).</li>
            <li>Organiser des concerts, scènes ouvertes et rencontres musicales.</li>
            <li>Collaborer avec les associations et acteurs culturels locaux.</li>
          </ul>
        </div>
      </section>

      <section class="join" id="participer" aria-labelledby="join-title">
        <p class="eyebrow">Envie de jouer ?</p>
        <h2 id="join-title">Rejoignez-nous.</h2>
        <p>Entrez simplement en contact avec nous et on vous explique tout.</p>
        <div class="contact-actions">
          <a class="button button-light" href="mailto:contact@frequences-croisees.fr"><span class="contact-icon" aria-hidden="true" set:html={mail} /><span class="contact-label">contact@frequences-croisees.fr</span></a>
          <a class="button button-light" href="tel:+33678155326"><span class="contact-icon" aria-hidden="true" set:html={phone} /><span class="contact-label">06 78 15 53 26</span></a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
