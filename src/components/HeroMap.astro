<style>
  .hero-map {
    width:100%;
    max-width:650px;
    min-width:0;
    margin:0 auto;
    align-self:center;
  }
  .local-map { display:block; width:100%; height:auto; overflow:hidden; }
  .map-contours { fill:none; stroke:#d5d4b8; stroke-width:1; opacity:.75; }
  .map-woods { fill:#cbd6b1; opacity:.65; }
  .map-roads { fill:none; stroke:#95aa96; stroke-width:1.5; stroke-linecap:round; stroke-linejoin:round; opacity:.85; }
  .map-river-bed,.map-river { fill:none; stroke-linecap:round; stroke-linejoin:round; }
  .map-river-bed { stroke:#c8e3da; stroke-width:15; }
  .map-river { stroke:url(#map-water); stroke-width:11; }
  .map-town circle { fill:var(--orange); stroke:var(--paper); stroke-width:4; }
  .map-town-name {
    fill:var(--ink);
    font-family:'Playfair Display',serif;
    font-size:29px;
    font-weight:700;
    letter-spacing:-.8px;
    paint-order:stroke fill;
    stroke:var(--paper);
    stroke-width:5px;
    stroke-linejoin:round;
  }
  .map-town-name-long { font-size:27px; }
  .map-river-name { fill:#267a78; font:italic 600 28px 'Playfair Display',serif; }
  .map-precy-ring { fill:var(--paper); stroke:var(--yellow); stroke-width:7; }
  .map-precy-point { fill:var(--orange); }
  .map-precy-label { fill:var(--orange); }
  .map-precy-label text { fill:var(--paper); font:700 35px 'Playfair Display',serif; letter-spacing:-1px; }
  .map-resonance { fill:none; stroke:var(--yellow); stroke-width:2; opacity:0; transform-box:fill-box; transform-origin:center; }

  /* Une seule arrivée, terminée en 4,4 s. La carte reste ensuite immobile. */
  @media(prefers-reduced-motion:no-preference) {
    .map-river { animation:river-arrive 1.65s ease-out both; }
    .map-town { animation:town-arrive .6s ease-out var(--town-delay) both; }
    .map-precy-label { animation:town-arrive .7s ease-out .95s both; }
    .map-resonance-one { animation:map-resonate 1.4s ease-out 1.2s 2 both; }
    .map-resonance-two { animation:map-resonate 1.4s ease-out 1.6s 2 both; }
  }
  @keyframes river-arrive {
    from { stroke-dasharray:1; stroke-dashoffset:1; }
    to { stroke-dasharray:1; stroke-dashoffset:0; }
  }
  @keyframes town-arrive { from { opacity:0; } to { opacity:1; } }
  @keyframes map-resonate {
    0% { opacity:0; transform:scale(.65); }
    15% { opacity:.65; }
    100% { opacity:0; transform:scale(2.4); }
  }
  @media(max-width:800px) {
    .hero-map { max-width:560px; margin-top:5px; }
  }
</style>
